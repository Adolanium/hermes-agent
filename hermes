#!/usr/bin/env python3
"""Hermes Zero CLI launcher (no TUI, desktop, or gateway)."""

import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(_ROOT))
for _src in (
    _ROOT / "packages" / "hermes-zero" / "src",
    _ROOT / "packages" / "hermes-host" / "src",
    _ROOT / "packages" / "hermes-agent-sdk" / "src",
):
    if _src.is_dir():
        sys.path.insert(0, str(_src))

if __name__ == "__main__":
    from hermes_zero.cli import main
    raise SystemExit(main())
